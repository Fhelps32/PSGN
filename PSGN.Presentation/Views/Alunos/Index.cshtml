@using System.Globalization
@using PSGN.Domain.Enum
@model AlunosViewModel
@* REVISÃO: página de Alunos refeita no layout mestre-detalhe da página de Alunos do PSG, com o design system do PSGN:
   - à esquerda: busca (nome ou matrícula), filtros e a lista paginada de alunos;
   - à direita: o aluno selecionado, o MÓDULO ATUAL com a tentativa em curso (prazo, prova, nota e as ações do administrador)
     e o HISTÓRICO de todos os módulos em que entrou, com todas as tentativas de cada um.
   As regras (nota mínima 7, prazo de 40 dias, quais ações são permitidas) vêm prontas do domínio; a view só mostra *@
@{
    ViewData["Title"] = "Alunos"; // título da aba e da página
    ViewData["Section"] = "Acadêmico"; // grupo da sidebar (lido pela partial _PageHeader)
    ViewData["Subtitle"] = "Módulo atual e histórico de tentativas de cada aluno"; // subtítulo (lido pela partial _PageHeader)

    var ptBr = CultureInfo.GetCultureInfo("pt-BR"); // nota com vírgula (7,5), independente do idioma do servidor
    var sel = Model.Selecionado; // aluno do painel da direita (null quando a lista está vazia)
    var filtrando = !string.IsNullOrWhiteSpace(Model.Nome) || Model.CursoId.HasValue || Model.ModuloId.HasValue; // algum filtro ativo?

    // Rota de cada aluno da lista: os filtros e a página atuais + o aluno escolhido
    Dictionary<string, string> RotaDoAluno(int idAluno)
    {
        var rota = new Dictionary<string, string>(Model.Paginacao.Rota); // filtros ativos
        rota["Pagina"] = Model.Paginacao.PaginaAtual.ToString(); // mesma página
        rota["AlunoId"] = idAluno.ToString(); // o aluno clicado
        return rota; // pronto para asp-all-route-data
    }

    // Iniciais para o avatar (primeira letra do primeiro e do último nome)
    string Iniciais(string nome)
    {
        var partes = nome.Split(' ', StringSplitOptions.RemoveEmptyEntries); // palavras do nome
        var iniciais = partes.Length == 0 ? "?" : partes.Length == 1 ? partes[0][..1] : $"{partes[0][0]}{partes[^1][0]}"; // sem nome, uma palavra ou várias
        return iniciais.ToUpperInvariant(); // "AR"
    }

    // Campos escondidos que todo formulário de ação leva, para o controller voltar exatamente para esta tela
    void CamposDeRetorno()
    {
        <input type="hidden" name="alunoId" value="@sel!.IdAluno" />
        <input type="hidden" name="nome" value="@Model.Nome" />
        <input type="hidden" name="cursoId" value="@Model.CursoId" />
        <input type="hidden" name="moduloId" value="@Model.ModuloId" />
        <input type="hidden" name="pagina" value="@Model.Paginacao.PaginaAtual" />
    }

    // REVISÃO: ações do administrador sobre uma tentativa aberta, num lugar só: usadas no card do módulo atual e no histórico
    // (módulos antigos também podem ter tentativa aberta). Só aparecem as permitidas pelo domínio; todas pedem confirmação, porque não se desfazem
    async Task AcoesDaTentativa(AlunosTentativaItem t, bool compacto) // async: o Razor exige quando a função tem tag helpers (os <form asp-action>)
    {
        var tamanho = compacto ? " btn-sm" : ""; // no histórico os botões são menores
        if (t.PodeAprovar)
        {
            <form asp-action="Aprovar" method="post" data-loading data-confirm-titulo="Aprovar a tentativa?" data-confirm-acao="Aprovar"
                  data-confirm="A tentativa será fechada como aprovada e o módulo, concluído. O próximo módulo entra pela sincronização com o Moodle.">
                <input type="hidden" name="idTentativa" value="@t.IdTentativa" />
                @{ CamposDeRetorno(); }
                <button type="submit" class="btn btn-primary@(tamanho)" data-loading-text="Aprovando…"><i class="bi bi-check2-circle" aria-hidden="true"></i><span data-loading-label>Aprovar</span></button>
            </form>
        }
        if (t.PodeReprovar)
        {
            <form asp-action="Reprovar" method="post" data-loading data-confirm-perigo data-confirm-titulo="Reprovar a tentativa?" data-confirm-acao="Reprovar e abrir nova"
                  data-confirm="A tentativa será fechada como reprovada (nota abaixo de 7) e uma nova será aberta, com prazo de 40 dias.">
                <input type="hidden" name="idTentativa" value="@t.IdTentativa" />
                @{ CamposDeRetorno(); }
                <button type="submit" class="btn btn-secondary@(tamanho)" data-loading-text="Reprovando…"><i class="bi bi-arrow-repeat" aria-hidden="true"></i><span data-loading-label>Reprovar e abrir nova</span></button>
            </form>
        }
        if (t.PodeReprovarPorInatividade)
        {
            <form asp-action="ReprovarPorInatividade" method="post" data-loading data-confirm-perigo data-confirm-titulo="Reprovar por inatividade?" data-confirm-acao="Reprovar por inatividade"
                  data-confirm="O aluno não fez a prova. A tentativa será fechada como reprovada por inatividade e uma nova será aberta, com prazo de 40 dias.">
                <input type="hidden" name="idTentativa" value="@t.IdTentativa" />
                @{ CamposDeRetorno(); }
                <button type="submit" class="btn btn-secondary@(tamanho)" data-loading-text="Reprovando…"><i class="bi bi-hourglass-bottom" aria-hidden="true"></i><span data-loading-label>Reprovar por inatividade</span></button>
            </form>
        }
    }
}

@functions {
    // Situação da tentativa: texto e etiqueta (cores de FEEDBACK; sempre com texto, nunca só a cor)
    static string SituacaoTexto(EnumSituacaoTentativa s) => s switch
    {
        EnumSituacaoTentativa.AguardandoProva => "Aguardando prova",
        EnumSituacaoTentativa.ProvaEmCorrecao => "Prova sem nota",
        EnumSituacaoTentativa.AguardandoAprovacao => "Nota ≥ 7 · aguardando aprovação",
        EnumSituacaoTentativa.AguardandoReprovacao => "Nota abaixo de 7",
        EnumSituacaoTentativa.Aprovada => "Aprovada",
        EnumSituacaoTentativa.Reprovada => "Reprovada",
        EnumSituacaoTentativa.ReprovadaPorInatividade => "Reprovada por inatividade",
        _ => s.ToString()
    };

    static string SituacaoClasse(EnumSituacaoTentativa s) => s switch
    {
        EnumSituacaoTentativa.AguardandoProva => "badge badge-accent",
        EnumSituacaoTentativa.ProvaEmCorrecao => "badge",
        EnumSituacaoTentativa.AguardandoAprovacao => "badge badge-success",
        EnumSituacaoTentativa.AguardandoReprovacao => "badge badge-warning",
        EnumSituacaoTentativa.Aprovada => "badge badge-success",
        _ => "badge badge-danger" // reprovada (pela nota ou por inatividade)
    };

    static string Data(DateTime? d) => d?.ToString("dd/MM/yyyy") ?? "—"; // data ou traço
    static string Ordinal(int n) => $"{n}ª"; // 1ª, 2ª...
    static string Prazo(int dias) => dias switch { > 1 => $"faltam {dias} dias", 1 => "falta 1 dia", 0 => "vence hoje", -1 => "vencido há 1 dia", _ => $"vencido há {-dias} dias" }; // texto do prazo
}

@* ===== Cabeçalho da página ===== *@
<div class="page-header">
    <partial name="_PageHeader" /> @* grupo + título + subtítulo *@
    <p role="status" class="badge text-sm"> @* total dinâmico: muda conforme o filtro *@
        <i class="bi bi-people" aria-hidden="true"></i>
        <span class="tabular-nums">@Model.TotalAlunos</span>&nbsp;@(Model.TotalAlunos == 1 ? "aluno" : "alunos")@(filtrando ? " nos filtros aplicados" : "")
    </p>
</div>

@* Resultado das ações do administrador (TempData -> toast) *@
@if (ViewData["MensagemAluno"] is string mensagem) { <template data-toast="success">@mensagem</template> }
@if (ViewData["ErroAluno"] is string erro) { <template data-toast="danger">@erro</template> }

@* Duas colunas a partir de 1280px: lista estreita à esquerda, detalhe largo à direita. Abaixo disso, a lista vem em cima e o detalhe embaixo *@
<div class="grid items-start gap-6 xl:grid-cols-[22rem_minmax(0,1fr)]">

    @* ===================== COLUNA ESQUERDA: busca, filtros e lista ===================== *@
    <section class="flex min-w-0 flex-col gap-4" aria-label="Lista de alunos">

        @* GET: o filtro vai na URL; data-url-modulos é lido pelo alunos.js para a cascata Curso -> Módulo *@
        <form asp-action="Index" method="get" data-url-modulos="@Url.Action("GetModulosPorCurso", "Alunos")" class="card space-y-3 p-4">
            <div>
                <label asp-for="Nome" class="field-label">Nome ou matrícula</label>
                <input asp-for="Nome" type="search" placeholder="Pesquisar" autocomplete="off" class="input" />
            </div>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-1"> @* lado a lado no tablet; empilhados na coluna estreita do desktop *@
                <div>
                    <label asp-for="CursoId" class="field-label">Curso</label>
                    <select asp-for="CursoId" asp-items="Model.Cursos" class="input">
                        <option value="">Todos os cursos</option>
                    </select>
                </div>
                <div>
                    <label asp-for="ModuloId" class="field-label">Módulo</label>
                    @* Desabilitado até escolher um curso (um select desabilitado não vai na URL) *@
                    <select asp-for="ModuloId" asp-items="Model.Modulos" disabled="@(!Model.CursoId.HasValue)" class="input">
                        <option value="">Todos os módulos</option>
                    </select>
                </div>
            </div>
            <div class="flex gap-2">
                <button type="submit" class="btn btn-primary flex-1"><i class="bi bi-search" aria-hidden="true"></i>Filtrar</button>
                @if (filtrando)
                {
                    <a asp-action="Index" class="btn btn-secondary">Limpar</a>
                }
            </div>
        </form>

        <div class="card flex flex-col p-3">
            @if (Model.Alunos.Count == 0)
            {
                <partial name="_EmptyState" model='new EstadoVazioViewModel { Icone = filtrando ? "bi-search" : "bi-people", Titulo = filtrando ? "Nenhum aluno encontrado" : "Nenhum aluno sincronizado", Descricao = filtrando ? "Tente outros termos ou limpe os filtros." : "Os alunos chegam do Moodle pela sincronização, na tela de Cursos." }' />
            }
            else
            {
                @* Rolagem só na lista no desktop: a página não precisa rolar inteira para ver os alunos *@
                <ul id="listaAlunos" class="flex flex-col gap-1.5 overflow-y-auto pr-0.5 xl:max-h-[calc(100vh-24rem)] xl:min-h-[16rem]">
                    @foreach (var aluno in Model.Alunos)
                    {
                        <li>
                            <a asp-action="Index" asp-all-route-data="RotaDoAluno(aluno.IdAluno)" asp-fragment="detalhe-aluno"
                               class="list-item" aria-current="@(aluno.Selecionado ? "true" : null)">
                                <span class="avatar" aria-hidden="true">@Iniciais(aluno.Nome)</span> @* iniciais (decorativo) *@
                                <span class="min-w-0 flex-1">
                                    <span class="block truncate text-sm font-medium text-ink" title="@aluno.Nome">@aluno.Nome</span>
                                    <span class="block truncate text-xs text-ink-soft">Matrícula @aluno.Matricula</span>
                                    <span class="block truncate text-xs text-ink-muted" title="@aluno.ModuloAtual">@(string.IsNullOrEmpty(aluno.ModuloAtual) ? "Sem módulo" : aluno.ModuloAtual)</span>
                                </span>
                            </a>
                        </li>
                    }
                </ul>
                <div class="mt-3 border-t border-line pt-3"><partial name="_Paginacao" model="Model.Paginacao" /></div>
            }
        </div>
    </section>

    @* ===================== COLUNA DIREITA: aluno selecionado ===================== *@
    <section id="detalhe-aluno" class="flex min-w-0 scroll-mt-20 flex-col gap-4" aria-label="Aluno selecionado">
        @if (sel is null)
        {
            <div class="card">
                <partial name="_EmptyState" model='new EstadoVazioViewModel { Icone = "bi-person-lines-fill", Titulo = "Nenhum aluno selecionado", Descricao = "Escolha um aluno na lista para ver o módulo atual e o histórico de tentativas." }' />
            </div>
        }
        else
        {
            @* ----- Identificação ----- *@
            <div class="card flex flex-wrap items-start justify-between gap-4 p-5">
                <div class="flex min-w-0 items-center gap-3">
                    <span class="avatar h-11 w-11 text-sm" aria-hidden="true">@Iniciais(sel.Nome)</span>
                    <div class="min-w-0">
                        <h2 class="break-words text-lg font-semibold text-ink">@sel.Nome</h2> @* nome inteiro, sem cortar *@
                        <p class="text-xs text-ink-soft">Matrícula @sel.Matricula · @sel.Curso</p>
                    </div>
                </div>
                <p class="badge text-sm"><i class="bi bi-check2-circle" aria-hidden="true"></i><span class="tabular-nums">@sel.ModulosConcluidos/@sel.TotalModulosCurso</span>&nbsp;módulos concluídos</p>
            </div>

            @* ----- Módulo atual ----- *@
            <div class="card p-5">
                <p class="page-eyebrow">Módulo atual</p>
                @if (sel.ModuloAtual is null)
                {
                    <p class="text-sm text-ink-soft">Este aluno ainda não entrou em nenhum módulo.</p>
                }
                else
                {
                    var atual = sel.ModuloAtual; // o último módulo em que entrou
                    var aberta = atual.TentativaAberta; // a tentativa em curso, se houver

                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <div class="min-w-0">
                            <h3 class="break-words text-base font-semibold text-ink">@atual.Nome</h3>
                            <p class="mt-0.5 text-xs text-ink-soft">Entrou em @Data(atual.DataInscricao)@(atual.TentativasReprovadas > 0 ? $" · {atual.TentativasReprovadas} {(atual.TentativasReprovadas == 1 ? "reprovação" : "reprovações")}" : "")</p>
                        </div>
                        @if (atual.Aprovado) { <span class="badge badge-success"><i class="bi bi-check-circle" aria-hidden="true"></i>Aprovado</span> }
                    </div>

                    @if (aberta is not null)
                    {
                        @* Tentativa em curso: tudo o que o administrador precisa para decidir *@
                        <div class="mt-4 rounded-control border border-line bg-page p-4">
                            <div class="mb-3 flex flex-wrap items-center gap-2">
                                <span class="text-sm font-semibold text-ink">@Ordinal(aberta.Numero) tentativa</span>
                                <span class="@SituacaoClasse(aberta.Situacao)">@SituacaoTexto(aberta.Situacao)</span>
                                @if (aberta.PrazoVencido) { <span class="badge badge-warning"><i class="bi bi-alarm" aria-hidden="true"></i>Prazo vencido</span> }
                            </div>
                            <dl class="facts">
                                <div><dt>Abertura</dt><dd class="tabular-nums">@Data(aberta.DataInicio)</dd></div>
                                <div><dt>Prazo (40 dias)</dt><dd class="tabular-nums">@Data(aberta.DataLimite) <span class="block text-xs font-normal @(aberta.PrazoVencido ? "text-warning" : "text-ink-soft")">@Prazo(aberta.DiasParaOPrazo)</span></dd></div>
                                <div><dt>Prova</dt><dd class="tabular-nums">@(aberta.DataProva is null ? "Não realizada" : Data(aberta.DataProva))</dd></div>
                                <div><dt>Nota</dt><dd class="tabular-nums">@(aberta.Nota?.ToString("0.0#", ptBr) ?? "—")</dd></div>
                            </dl>

                            @* Ações permitidas (decididas pelo domínio). Todas pedem confirmação, porque não podem ser desfeitas *@
                            @if (aberta.PodeAprovar || aberta.PodeReprovar || aberta.PodeReprovarPorInatividade)
                            {
                                <div class="mt-4 flex flex-wrap gap-2 border-t border-line pt-4">
                                    @{ await AcoesDaTentativa(aberta, compacto: false); } @* REVISÃO: as ações vêm do bloco único definido no topo da view *@
                                </div>
                            }
                        </div>
                    }
                    else if (atual.Aprovado)
                    {
                        <div class="mt-4"><partial name="_Alert" model='new AlertaViewModel { Tipo = "success", Fechavel = false, Mensagem = $"Aprovado em {Data(atual.DataFim)}{(atual.NotaFinal is null ? "" : " com nota " + atual.NotaFinal.Value.ToString("0.0#", ptBr))}. O próximo módulo entra pela sincronização com o Moodle." }' /></div>
                    }
                    else if (atual.PodeAbrirTentativa)
                    {
                        <div class="mt-4 flex flex-wrap items-center justify-between gap-3 rounded-control border border-line bg-page p-4">
                            <p class="text-sm text-ink-soft">Nenhuma tentativa em curso neste módulo.</p>
                            <form asp-action="AbrirTentativa" method="post" data-loading data-confirm-titulo="Abrir nova tentativa?" data-confirm-acao="Abrir tentativa"
                                  data-confirm="Uma nova tentativa será aberta neste módulo, com prazo de 40 dias a partir de hoje.">
                                <input type="hidden" name="idAlunoModulo" value="@atual.IdAlunoModulo" />
                                @{ CamposDeRetorno(); }
                                <button type="submit" class="btn btn-secondary" data-loading-text="Abrindo…"><i class="bi bi-plus-lg" aria-hidden="true"></i><span data-loading-label>Abrir nova tentativa</span></button>
                            </form>
                        </div>
                    }
                }
            </div>

            @* ----- Histórico: todos os módulos em que entrou, com todas as tentativas de cada um ----- *@
            <div class="card">
                <div class="card-header pb-4">
                    <div>
                        <h2 class="card-title">Histórico de módulos</h2>
                        <p class="card-desc">Todas as tentativas de cada módulo, da mais antiga para a mais recente</p>
                    </div>
                </div>

                @if (sel.Historico.Count == 0)
                {
                    <p class="border-t border-line px-5 py-6 text-sm text-ink-soft">Sem módulos ainda.</p>
                }
                else
                {
                    @foreach (var modulo in sel.Historico) // do módulo mais recente ao mais antigo
                    {
                        <details class="group border-t border-line" open="@modulo.Atual"> @* o módulo atual começa aberto *@
                            <summary class="flex cursor-pointer list-none items-center gap-3 px-5 py-3.5 hover:bg-surface-hover [&::-webkit-details-marker]:hidden">
                                <i class="bi bi-chevron-right text-ink-muted transition-transform group-open:rotate-90" aria-hidden="true"></i>
                                <span class="min-w-0 flex-1">
                                    <span class="block break-words text-sm font-medium text-ink">@modulo.Nome</span>
                                    <span class="block text-xs text-ink-soft">Entrou em @Data(modulo.DataInscricao)@(modulo.DataFim is null ? "" : $" · concluído em {Data(modulo.DataFim)}") · @modulo.Tentativas.Count @(modulo.Tentativas.Count == 1 ? "tentativa" : "tentativas")</span>
                                </span>
                                <span class="flex shrink-0 flex-wrap justify-end gap-1.5">
                                    @if (modulo.Atual) { <span class="badge badge-accent">Atual</span> }
                                    @if (modulo.Aprovado) { <span class="badge badge-success">Aprovado</span> }
                                    @if (modulo.TentativasReprovadas > 0) { <span class="badge badge-danger tabular-nums">@modulo.TentativasReprovadas @(modulo.TentativasReprovadas == 1 ? "reprovação" : "reprovações")</span> }
                                </span>
                            </summary>

                            <div class="px-5 pb-4">
                                @if (modulo.Tentativas.Count == 0)
                                {
                                    <p class="text-sm text-ink-soft">Nenhuma tentativa aberta neste módulo.</p>
                                }
                                else
                                {
                                    <div class="table-wrap">
                                        <table class="table table-stack" role="table">
                                            <caption class="sr-only">Tentativas no módulo @modulo.Nome</caption>
                                            <thead role="rowgroup">
                                                <tr role="row">
                                                    <th scope="col" role="columnheader">Tentativa</th>
                                                    <th scope="col" role="columnheader">Abertura</th>
                                                    <th scope="col" role="columnheader">Prazo</th>
                                                    <th scope="col" role="columnheader">Prova</th>
                                                    <th scope="col" role="columnheader" class="text-right">Nota</th>
                                                    <th scope="col" role="columnheader">Situação</th>
                                                    <th scope="col" role="columnheader">Encerrada</th>
                                                </tr>
                                            </thead>
                                            <tbody role="rowgroup">
                                                @foreach (var t in modulo.Tentativas) // da 1ª à mais recente
                                                {
                                                    <tr role="row">
                                                        <td role="cell" class="font-medium text-ink">@Ordinal(t.Numero)</td>
                                                        <td role="cell" data-label="Abertura" class="tabular-nums text-ink-soft">@Data(t.DataInicio)</td>
                                                        <td role="cell" data-label="Prazo" class="tabular-nums text-ink-soft">@Data(t.DataLimite)@if (t.PrazoVencido) { <span class="badge badge-warning ml-1">Vencido</span> }</td>
                                                        <td role="cell" data-label="Prova" class="tabular-nums text-ink-soft">@Data(t.DataProva)</td>
                                                        <td role="cell" data-label="Nota" class="tabular-nums font-medium text-ink md:text-right">@(t.Nota?.ToString("0.0#", ptBr) ?? "—")</td>
                                                        <td role="cell" data-label="Situação"><span class="@SituacaoClasse(t.Situacao)">@SituacaoTexto(t.Situacao)</span></td>
                                                        <td role="cell" data-label="Encerrada" class="tabular-nums text-ink-soft">@(t.Aberta ? "Em curso" : Data(t.DataFim))</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }

                                @* REVISÃO: tentativa aberta num módulo que NÃO é o atual (ex.: aluno inscrito em vários módulos ao mesmo tempo): as mesmas ações do card acima *@
                                @if (!modulo.Atual && modulo.TentativaAberta is { } abertaAntiga && (abertaAntiga.PodeAprovar || abertaAntiga.PodeReprovar || abertaAntiga.PodeReprovarPorInatividade))
                                {
                                    <div class="mt-3 flex flex-wrap items-center gap-2">
                                        <span class="text-xs text-ink-soft">@Ordinal(abertaAntiga.Numero) tentativa em curso:</span>
                                        @{ await AcoesDaTentativa(abertaAntiga, compacto: true); }
                                    </div>
                                }

                                @* Módulo sem tentativa em curso e não aprovado (o atual já mostra o botão no card acima) *@
                                @if (modulo.PodeAbrirTentativa && !modulo.Atual)
                                {
                                    <form asp-action="AbrirTentativa" method="post" class="mt-3" data-loading data-confirm-titulo="Abrir nova tentativa?" data-confirm-acao="Abrir tentativa"
                                          data-confirm="Uma nova tentativa será aberta neste módulo, com prazo de 40 dias a partir de hoje.">
                                        <input type="hidden" name="idAlunoModulo" value="@modulo.IdAlunoModulo" />
                                        @{ CamposDeRetorno(); }
                                        <button type="submit" class="btn btn-secondary btn-sm" data-loading-text="Abrindo…"><i class="bi bi-plus-lg" aria-hidden="true"></i><span data-loading-label>Abrir nova tentativa</span></button>
                                    </form>
                                }
                            </div>
                        </details>
                    }
                }
            </div>
        }
    </section>
</div>

@section Scripts {
    <script src="~/js/alunos.js" asp-append-version="true"></script> @* cascata Curso -> Módulo e aluno selecionado visível na lista *@
}
