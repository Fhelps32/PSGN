@using System.Globalization
@using PSGN.Domain.Enum
@model AlunosViewModel
@* Página de Alunos (AlunosController.Index), no layout do PSG: filtros e lista paginada à esquerda; à direita o aluno selecionado
   (identificação, módulo atual, módulos com todas as tentativas e tentativas reprovadas). As regras vêm prontas do domínio *@
@{
    ViewData["Title"] = "Alunos";
    ViewData["Section"] = "Acadêmico";
    ViewData["Subtitle"] = "Acompanhamento dos alunos, do módulo atual e das tentativas de cada módulo";

    var ptBr = CultureInfo.GetCultureInfo("pt-BR");
    var sel = Model.Selecionado;
    var filtrando = !string.IsNullOrWhiteSpace(Model.Nome) || Model.CursoId.HasValue || Model.ModuloId.HasValue;
    var pag = Model.Paginacao;

    // Link de cada aluno: filtros e página atuais + o aluno
    Dictionary<string, string> RotaDoAluno(int idAluno)
    {
        var rota = new Dictionary<string, string>(pag.Rota);
        rota["Pagina"] = pag.PaginaAtual.ToString();
        rota["AlunoId"] = idAluno.ToString();
        return rota;
    }

    // Iniciais do avatar (primeiro e último nome)
    string Iniciais(string nome)
    {
        var partes = nome.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var iniciais = partes.Length == 0 ? "?" : partes.Length == 1 ? partes[0][..1] : $"{partes[0][0]}{partes[^1][0]}";
        return iniciais.ToUpperInvariant();
    }

    // Campos escondidos dos formulários de ação, para o controller voltar a esta mesma tela
    void CamposDeRetorno()
    {
        <input type="hidden" name="alunoId" value="@sel!.IdAluno" />
        <input type="hidden" name="nome" value="@Model.Nome" />
        <input type="hidden" name="cursoId" value="@Model.CursoId" />
        <input type="hidden" name="moduloId" value="@Model.ModuloId" />
        <input type="hidden" name="pagina" value="@pag.PaginaAtual" />
    }

    // Botões das ações permitidas numa tentativa aberta (card Módulo atual e lista de Módulos). Todos pedem confirmação (ui.js)
    async Task AcoesDaTentativa(AlunosTentativaItem t, bool compacto)
    {
        var tamanho = compacto ? " btn-sm" : "";
        if (t.PodeAprovar)
        {
            <form asp-action="Aprovar" method="post" data-loading data-confirm-titulo="Aprovar a tentativa?" data-confirm-acao="Aprovar"
                  data-confirm="A tentativa será fechada como aprovada e o módulo, concluído. O próximo módulo entra pela sincronização com o Moodle.">
                <input type="hidden" name="idTentativa" value="@t.IdTentativa" />
                @{ CamposDeRetorno(); }
                <button type="submit" class="btn btn-primary@(tamanho)" data-loading-text="Aprovando…"><i class="bi bi-check2-circle" aria-hidden="true"></i><span data-loading-label>Aprovar</span></button>
            </form>
        }
        if (t.PodeReprovar)
        {
            <form asp-action="Reprovar" method="post" data-loading data-confirm-perigo data-confirm-titulo="Reprovar a tentativa?" data-confirm-acao="Reprovar e abrir nova"
                  data-confirm="A tentativa será fechada como reprovada (nota abaixo de 7) e uma nova será aberta, com prazo de 40 dias.">
                <input type="hidden" name="idTentativa" value="@t.IdTentativa" />
                @{ CamposDeRetorno(); }
                <button type="submit" class="btn btn-secondary@(tamanho)" data-loading-text="Reprovando…"><i class="bi bi-arrow-repeat" aria-hidden="true"></i><span data-loading-label>Reprovar e abrir nova</span></button>
            </form>
        }
        if (t.PodeReprovarPorInatividade)
        {
            <form asp-action="ReprovarPorInatividade" method="post" data-loading data-confirm-perigo data-confirm-titulo="Reprovar por inatividade?" data-confirm-acao="Reprovar por inatividade"
                  data-confirm="O aluno não fez a prova. A tentativa será fechada como reprovada por inatividade e uma nova será aberta, com prazo de 40 dias.">
                <input type="hidden" name="idTentativa" value="@t.IdTentativa" />
                @{ CamposDeRetorno(); }
                <button type="submit" class="btn btn-secondary@(tamanho)" data-loading-text="Reprovando…"><i class="bi bi-hourglass-bottom" aria-hidden="true"></i><span data-loading-label>Reprovar por inatividade</span></button>
            </form>
        }
    }

    // Botão "Abrir nova tentativa" (card Módulo atual e módulos antigos)
    async Task BotaoAbrirTentativa(int idAlunoModulo, bool compacto)
    {
        <form asp-action="AbrirTentativa" method="post" data-loading data-confirm-titulo="Abrir nova tentativa?" data-confirm-acao="Abrir tentativa"
              data-confirm="Uma nova tentativa será aberta neste módulo, com prazo de 40 dias a partir de hoje.">
            <input type="hidden" name="idAlunoModulo" value="@idAlunoModulo" />
            @{ CamposDeRetorno(); }
            <button type="submit" class="btn btn-secondary@(compacto ? " btn-sm" : "")" data-loading-text="Abrindo…"><i class="bi bi-plus-lg" aria-hidden="true"></i><span data-loading-label>Abrir nova tentativa</span></button>
        </form>
    }
}

@functions {
    // Texto e etiqueta da situação da tentativa (cores de feedback, sempre com texto)
    static string SituacaoTexto(EnumSituacaoTentativa s) => s switch
    {
        EnumSituacaoTentativa.AguardandoProva => "Aguardando prova",
        EnumSituacaoTentativa.ProvaEmCorrecao => "Prova sem nota",
        EnumSituacaoTentativa.AguardandoAprovacao => "Aguardando aprovação",
        EnumSituacaoTentativa.AguardandoReprovacao => "Nota abaixo de 7",
        EnumSituacaoTentativa.Aprovada => "Aprovada",
        EnumSituacaoTentativa.Reprovada => "Reprovada",
        EnumSituacaoTentativa.ReprovadaPorInatividade => "Reprovada por inatividade",
        _ => s.ToString()
    };

    static string SituacaoClasse(EnumSituacaoTentativa s) => s switch
    {
        EnumSituacaoTentativa.AguardandoProva => "badge badge-accent",
        EnumSituacaoTentativa.ProvaEmCorrecao => "badge",
        EnumSituacaoTentativa.AguardandoAprovacao => "badge badge-success",
        EnumSituacaoTentativa.AguardandoReprovacao => "badge badge-warning",
        EnumSituacaoTentativa.Aprovada => "badge badge-success",
        _ => "badge badge-danger" // reprovada (pela nota ou por inatividade)
    };

    // Situação do módulo: aprovado, em andamento, sem tentativa ou reprovado
    static string ModuloTexto(AlunosModuloItem m)
    {
        if (m.Aprovado) return "Aprovado";
        if (m.TentativaAberta is not null) return "Em andamento";
        return m.Tentativas.Count == 0 ? "Sem tentativa" : "Reprovado";
    }

    static string ModuloClasse(AlunosModuloItem m)
    {
        if (m.Aprovado) return "badge badge-success";
        if (m.TentativaAberta is not null) return "badge badge-accent";
        return m.Tentativas.Count == 0 ? "badge" : "badge badge-danger";
    }

    static bool Reprovada(AlunosTentativaItem t) => t.Situacao is EnumSituacaoTentativa.Reprovada or EnumSituacaoTentativa.ReprovadaPorInatividade;

    static string Data(DateTime? d) => d?.ToString("dd/MM/yyyy") ?? "—";
    static string Ordinal(int n) => $"{n}ª";
    static string Prazo(int dias) => dias switch { > 1 => $"faltam {dias} dias", 1 => "falta 1 dia", 0 => "vence hoje", -1 => "vencido há 1 dia", _ => $"vencido há {-dias} dias" };
}

@* ===== Cabeçalho da página ===== *@
<div class="page-header">
    <partial name="_PageHeader" />
</div>

@* Resultado das ações do administrador (TempData -> toast) *@
@if (ViewData["MensagemAluno"] is string mensagem) { <template data-toast="success">@mensagem</template> }
@if (ViewData["ErroAluno"] is string erro) { <template data-toast="danger">@erro</template> }

@* Duas colunas a partir de 1280px; minmax(0,1fr) deixa a coluna da lista encolher sem empurrar o detalhe para fora da tela *@
<div class="grid grid-cols-1 items-start gap-6 xl:grid-cols-[minmax(0,1fr)_26rem]">

    @* ===================== COLUNA ESQUERDA: filtros e lista ===================== *@
    <section class="flex min-w-0 flex-col gap-4" aria-label="Lista de alunos">

        @* Filtros via GET (a lista é paginada no servidor); data-url-modulos alimenta a cascata Curso -> Módulo do alunos.js *@
        <form asp-action="Index" method="get" data-url-modulos="@Url.Action("GetModulosPorCurso", "Alunos")" class="flex flex-wrap items-end gap-3">
            <div class="min-w-[11rem] flex-1">
                <label asp-for="Nome" class="field-label">Nome ou matrícula</label>
                <div class="relative">
                    <i class="bi bi-search pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-ink-muted" aria-hidden="true"></i>
                    <input asp-for="Nome" type="search" placeholder="Pesquisar" autocomplete="off" class="input pl-9" />
                </div>
            </div>
            <div class="w-full sm:w-44">
                <label asp-for="CursoId" class="field-label">Curso</label>
                <select asp-for="CursoId" asp-items="Model.Cursos" class="input">
                    <option value="">Todos os cursos</option>
                </select>
            </div>
            <div class="w-full sm:w-44">
                <label asp-for="ModuloId" class="field-label">Módulo</label>
                @* Desabilitado até escolher um curso (um select desabilitado não vai na URL) *@
                <select asp-for="ModuloId" asp-items="Model.Modulos" disabled="@(!Model.CursoId.HasValue)" class="input">
                    <option value="">Todos os módulos</option>
                </select>
            </div>
            <div class="flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-funnel" aria-hidden="true"></i>Filtrar</button>
                @if (filtrando)
                {
                    <a asp-action="Index" class="btn btn-secondary">Limpar</a>
                }
            </div>
        </form>

        @* Altura fixa e rolagem só na lista (17rem = padding do main + cabeçalho + filtros) *@
        <div class="card flex h-[36rem] flex-col p-4 xl:h-[calc(100vh-17rem)] xl:min-h-[28rem]">

            <div class="mb-4 flex shrink-0 flex-wrap items-center justify-between gap-3">
                <p role="status" class="inline-flex items-center gap-2 rounded-control border border-line px-3 py-1.5 text-sm text-ink-soft">
                    <i class="bi bi-people" aria-hidden="true"></i>
                    Quantidade de alunos:
                    <span class="font-semibold tabular-nums text-ink">@Model.TotalAlunos</span>
                </p>

                @if (pag.TotalPaginas > 1)
                {
                    var inicio = Math.Max(1, pag.PaginaAtual - 1);
                    var fim = Math.Min(pag.TotalPaginas, pag.PaginaAtual + 1);

                    <nav aria-label="Paginação" class="flex items-center gap-1">
                        <a asp-action="Index" asp-all-route-data="pag.Rota" asp-route-Pagina="@Math.Max(1, pag.PaginaAtual - 1)" class="pager-btn"
                           aria-label="Página anterior" aria-disabled="@(pag.TemAnterior ? null : "true")" tabindex="@(pag.TemAnterior ? null : "-1")"><i class="bi bi-chevron-left" aria-hidden="true"></i></a>
                        @for (var p = inicio; p <= fim; p++)
                        {
                            <a asp-action="Index" asp-all-route-data="pag.Rota" asp-route-Pagina="@p" class="pager-btn tabular-nums"
                               aria-label="Página @p" aria-current="@(p == pag.PaginaAtual ? "page" : null)">@p</a>
                        }
                        <a asp-action="Index" asp-all-route-data="pag.Rota" asp-route-Pagina="@Math.Min(pag.TotalPaginas, pag.PaginaAtual + 1)" class="pager-btn"
                           aria-label="Próxima página" aria-disabled="@(pag.TemProxima ? null : "true")" tabindex="@(pag.TemProxima ? null : "-1")"><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                        <span class="ml-2 text-xs text-ink-muted">Página @pag.PaginaAtual de @pag.TotalPaginas</span>
                    </nav>
                }
            </div>

            @if (Model.Alunos.Count == 0)
            {
                <partial name="_EmptyState" model='new EstadoVazioViewModel { Icone = filtrando ? "bi-search" : "bi-people", Titulo = filtrando ? "Nenhum aluno encontrado" : "Nenhum aluno sincronizado", Descricao = filtrando ? "Tente outros termos ou limpe os filtros." : "Os alunos chegam do Moodle pela sincronização, na tela de Cursos." }' />
            }
            else
            {
                @* relative: o alunos.js mede a posição do aluno selecionado dentro da lista *@
                <ul id="listaAlunos" class="relative flex min-h-0 flex-1 flex-col gap-2 overflow-y-auto pr-1">
                    @foreach (var aluno in Model.Alunos)
                    {
                        <li class="shrink-0">
                            <a asp-action="Index" asp-all-route-data="RotaDoAluno(aluno.IdAluno)"
                               class="list-row gap-3 px-4 py-3" aria-current="@(aluno.Selecionado ? "true" : null)">
                                <span class="avatar h-10 w-10 text-sm" aria-hidden="true">@Iniciais(aluno.Nome)</span>
                                <span class="min-w-0 flex-1">
                                    <span class="block truncate text-sm font-semibold text-ink" title="@aluno.Nome">@aluno.Nome <span class="font-normal text-ink-muted">/ @(string.IsNullOrWhiteSpace(aluno.Matricula) ? "sem matrícula" : aluno.Matricula)</span></span>
                                    <span class="mt-0.5 block truncate text-xs text-ink-soft" title="@aluno.ModuloAtual">Módulo atual: <span class="text-ink">@(string.IsNullOrEmpty(aluno.ModuloAtual) ? "nenhum" : aluno.ModuloAtual)</span></span>
                                </span>
                                <span class="hidden max-w-[12rem] shrink-0 text-right text-xs text-ink-soft sm:block">
                                    <span class="block truncate" title="@aluno.Curso">@aluno.Curso</span>
                                </span>
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>
    </section>

    @* ===================== COLUNA DIREITA: aluno selecionado ===================== *@
    <section id="detalhe-aluno" class="flex min-w-0 scroll-mt-20 flex-col gap-4" aria-label="Aluno selecionado">
        @if (sel is null)
        {
            <div class="card">
                <partial name="_EmptyState" model='new EstadoVazioViewModel { Icone = "bi-person-lines-fill", Titulo = "Nenhum aluno selecionado", Descricao = "Escolha um aluno na lista para ver o módulo atual e as tentativas de cada módulo." }' />
            </div>
        }
        else
        {
            var atual = sel.ModuloAtual;
            var aberta = atual?.TentativaAberta;
            var totalReprovadas = sel.Historico.Sum(m => m.TentativasReprovadas);

            @* ----- Identificação ----- *@
            <div class="card flex items-start justify-between gap-4 p-5">
                <div class="min-w-0">
                    <h2 class="break-words text-lg font-semibold leading-snug text-ink">@sel.Nome</h2>
                    <p class="mt-1 text-xs text-ink-soft">Matrícula: <span class="text-ink">@(string.IsNullOrWhiteSpace(sel.Matricula) ? "não informada" : sel.Matricula)</span></p>
                </div>
                <div class="max-w-[11rem] shrink-0 text-right">
                    <p class="text-xs font-medium uppercase tracking-wide text-ink-muted">Curso</p>
                    <p class="mt-0.5 break-words text-xs text-ink">@sel.Curso</p>
                    @if (aberta is not null)
                    {
                        <span class="@SituacaoClasse(aberta.Situacao) mt-1.5">@SituacaoTexto(aberta.Situacao)</span>
                    }
                    else if (atual is not null && atual.Aprovado)
                    {
                        <span class="badge badge-success mt-1.5">Módulo aprovado</span>
                    }
                </div>
            </div>

            @* ----- Módulo atual ----- *@
            <div class="card p-5">
                <p class="page-eyebrow">Módulo atual</p>
                @if (atual is null)
                {
                    <p class="text-sm text-ink-soft">Este aluno ainda não entrou em nenhum módulo.</p>
                }
                else
                {
                    <h3 class="break-words text-base font-semibold text-ink">@atual.Nome</h3>
                    <p class="mt-0.5 text-xs text-ink-soft">Entrou em @Data(atual.DataInscricao)@(atual.TentativasReprovadas > 0 ? $" · {atual.TentativasReprovadas} {(atual.TentativasReprovadas == 1 ? "reprovação" : "reprovações")}" : "")</p>

                    @if (aberta is not null)
                    {
                        <div class="mt-4 rounded-control border border-line bg-page p-4">
                            <div class="mb-3 flex flex-wrap items-center gap-2">
                                <span class="text-sm font-semibold text-ink">@Ordinal(aberta.Numero) tentativa</span>
                                @if (aberta.PrazoVencido) { <span class="badge badge-warning"><i class="bi bi-alarm" aria-hidden="true"></i>Prazo vencido</span> }
                            </div>
                            <dl class="facts facts-compact">
                                <div><dt>Abertura</dt><dd class="tabular-nums">@Data(aberta.DataInicio)</dd></div>
                                <div><dt>Prazo (40 dias)</dt><dd class="tabular-nums">@Data(aberta.DataLimite) <span class="block text-xs font-normal @(aberta.PrazoVencido ? "text-warning" : "text-ink-soft")">@Prazo(aberta.DiasParaOPrazo)</span></dd></div>
                                <div><dt>Prova</dt><dd class="tabular-nums">@(aberta.DataProva is null ? "Não realizada" : Data(aberta.DataProva))</dd></div>
                                <div><dt>Nota</dt><dd class="tabular-nums">@(aberta.Nota?.ToString("0.0#", ptBr) ?? "—")</dd></div>
                            </dl>

                            @if (aberta.PodeAprovar || aberta.PodeReprovar || aberta.PodeReprovarPorInatividade)
                            {
                                <div class="mt-4 flex flex-wrap gap-2 border-t border-line pt-4">
                                    @{ await AcoesDaTentativa(aberta, compacto: false); }
                                </div>
                            }
                        </div>
                    }
                    else if (atual.Aprovado)
                    {
                        <div class="mt-4"><partial name="_Alert" model='new AlertaViewModel { Tipo = "success", Fechavel = false, Mensagem = $"Aprovado em {Data(atual.DataFim)}{(atual.NotaFinal is null ? "" : " com nota " + atual.NotaFinal.Value.ToString("0.0#", ptBr))}. O próximo módulo entra pela sincronização com o Moodle." }' /></div>
                    }
                    else if (atual.PodeAbrirTentativa)
                    {
                        <div class="mt-4 flex flex-wrap items-center justify-between gap-3 rounded-control border border-line bg-page p-4">
                            <p class="text-sm text-ink-soft">Nenhuma tentativa em curso neste módulo.</p>
                            @{ await BotaoAbrirTentativa(atual.IdAlunoModulo, compacto: false); }
                        </div>
                    }
                }
            </div>

            @* ----- Módulos: todas as inscrições do aluno e todas as tentativas de cada uma ----- *@
            <div class="card p-5">
                <div class="mb-4 flex items-center justify-between gap-3">
                    <div class="flex items-center gap-2">
                        <h2 class="card-title">Módulos</h2>
                        <span class="badge tabular-nums" title="Módulos concluídos / módulos do curso">@sel.ModulosConcluidos/@sel.TotalModulosCurso</span>
                    </div>

                    @* Busca instantânea (alunos.js) *@
                    @if (sel.Historico.Count > 0)
                    {
                        <div class="relative">
                            <label for="buscaModulo" class="sr-only">Pesquisar módulo</label>
                            <i class="bi bi-search pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 text-xs text-ink-muted" aria-hidden="true"></i>
                            <input type="search" id="buscaModulo" placeholder="Pesquisar" autocomplete="off" class="input h-8 w-36 pl-8 text-xs" />
                        </div>
                    }
                </div>

                @if (sel.Historico.Count == 0)
                {
                    <p class="py-6 text-center text-sm text-ink-soft">Este aluno ainda não tem módulos.</p>
                }
                else
                {
                    <ul id="listaModulos" class="flex max-h-[32rem] flex-col gap-2 overflow-y-auto pr-1">
                        @foreach (var modulo in sel.Historico)
                        {
                            <li class="modulo-item rounded-control border border-line px-4 py-3" data-nome="@modulo.Nome">
                                <div class="flex items-start gap-3">
                                    <div class="min-w-0 flex-1">
                                        <p class="break-words text-sm font-semibold text-ink">@modulo.Nome</p>
                                        <p class="mt-1 text-xs text-ink-soft">Inscrição: <span class="text-ink">@Data(modulo.DataInscricao)</span></p>
                                        <p class="text-xs text-ink-soft">Fim: <span class="text-ink">@Data(modulo.DataFim)</span></p>
                                    </div>
                                    <div class="shrink-0 text-right">
                                        <span class="@ModuloClasse(modulo)">@ModuloTexto(modulo)</span>
                                        @if (modulo.NotaFinal is not null)
                                        {
                                            <p class="mt-1.5 text-sm font-bold tabular-nums text-ink"><span class="mr-1 text-xs font-normal text-ink-muted">Nota</span>@modulo.NotaFinal.Value.ToString("0.0#", ptBr)</p>
                                        }
                                    </div>
                                </div>

                                <div class="mt-3 border-t border-line pt-3">
                                    <p class="mb-1 text-xs font-medium text-ink-muted">@modulo.Tentativas.Count @(modulo.Tentativas.Count == 1 ? "tentativa" : "tentativas")</p>
                                    @if (modulo.Tentativas.Count == 0)
                                    {
                                        <p class="text-xs text-ink-soft">Nenhuma tentativa aberta neste módulo.</p>
                                    }
                                    else
                                    {
                                        <ol class="flex flex-col divide-y divide-line">
                                            @foreach (var t in modulo.Tentativas)
                                            {
                                                <li class="py-2 first:pt-0 last:pb-0">
                                                    <div class="flex flex-wrap items-center justify-between gap-x-2 gap-y-1">
                                                        <span class="text-sm font-medium text-ink">@Ordinal(t.Numero) tentativa</span>
                                                        <span class="flex flex-wrap justify-end gap-1">
                                                            @if (t.PrazoVencido) { <span class="badge badge-warning">Prazo vencido</span> }
                                                            <span class="@SituacaoClasse(t.Situacao)">@SituacaoTexto(t.Situacao)</span>
                                                        </span>
                                                    </div>
                                                    <p class="mt-1 flex flex-wrap gap-x-3 gap-y-0.5 text-xs text-ink-soft">
                                                        <span>Abertura <span class="tabular-nums text-ink">@Data(t.DataInicio)</span></span>
                                                        <span>Prazo <span class="tabular-nums text-ink">@Data(t.DataLimite)</span></span>
                                                        <span>Prova <span class="tabular-nums text-ink">@Data(t.DataProva)</span></span>
                                                        <span>Nota <span class="font-semibold tabular-nums text-ink">@(t.Nota?.ToString("0.0#", ptBr) ?? "—")</span></span>
                                                        @if (t.Aberta) { <span class="font-medium text-ink">Em curso</span> } else { <span>Encerrada <span class="tabular-nums text-ink">@Data(t.DataFim)</span></span> }
                                                    </p>
                                                </li>
                                            }
                                        </ol>
                                    }

                                    @* Tentativa aberta num módulo que não é o atual: as mesmas ações *@
                                    @if (!modulo.Atual && modulo.TentativaAberta is { } abertaAntiga && (abertaAntiga.PodeAprovar || abertaAntiga.PodeReprovar || abertaAntiga.PodeReprovarPorInatividade))
                                    {
                                        <div class="mt-3 flex flex-wrap items-center gap-2 border-t border-line pt-3">
                                            @{ await AcoesDaTentativa(abertaAntiga, compacto: true); }
                                        </div>
                                    }

                                    @if (modulo.PodeAbrirTentativa && !modulo.Atual)
                                    {
                                        <div class="mt-3 border-t border-line pt-3">
                                            @{ await BotaoAbrirTentativa(modulo.IdAlunoModulo, compacto: true); }
                                        </div>
                                    }
                                </div>
                            </li>
                        }
                    </ul>

                    <p id="semResultadoModulo" class="hidden py-6 text-center text-xs text-ink-soft">Nenhum módulo encontrado.</p>
                }
            </div>

            @* ----- Tentativas reprovadas (só aparece se houver) ----- *@
            @if (totalReprovadas > 0)
            {
                <div class="card overflow-hidden border-danger/30">
                    <div class="flex items-center gap-3 border-b border-danger/20 bg-danger-soft px-5 py-4">
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-control bg-card text-danger"><i class="bi bi-exclamation-triangle text-lg" aria-hidden="true"></i></span>
                        <div class="min-w-0 flex-1">
                            <h2 class="text-sm font-semibold leading-tight text-danger">Tentativas reprovadas</h2>
                            <p class="mt-0.5 text-xs text-danger">Pela nota ou por inatividade</p>
                        </div>
                        <span class="inline-flex h-7 min-w-7 shrink-0 items-center justify-center rounded-full bg-danger px-2 text-xs font-bold tabular-nums text-white">@totalReprovadas</span>
                    </div>

                    <ul class="flex max-h-72 flex-col divide-y divide-line overflow-y-auto">
                        @foreach (var modulo in sel.Historico)
                        {
                            @foreach (var t in modulo.Tentativas.Where(Reprovada))
                            {
                                <li class="flex items-center gap-3 px-5 py-3">
                                    <div class="min-w-0 flex-1">
                                        <p class="break-words text-sm font-semibold text-ink">@modulo.Nome</p>
                                        <p class="mt-1 text-xs text-ink-soft">@Ordinal(t.Numero) tentativa · @(t.Situacao == EnumSituacaoTentativa.ReprovadaPorInatividade ? "por inatividade" : "pela nota")</p>
                                        <p class="text-xs text-ink-soft">Abertura: <span class="text-ink">@Data(t.DataInicio)</span> <span class="mx-1 text-ink-muted">|</span> Encerrada: <span class="text-ink">@Data(t.DataFim)</span></p>
                                    </div>
                                    <div class="shrink-0 text-center">
                                        <p class="text-xs font-medium uppercase tracking-wide text-ink-muted">Nota</p>
                                        <p class="text-xl font-bold leading-tight tabular-nums text-danger">@(t.Nota?.ToString("0.0#", ptBr) ?? "—")</p>
                                    </div>
                                </li>
                            }
                        }
                    </ul>
                </div>
            }
        }
    </section>
</div>

@section Scripts {
    <script src="~/js/alunos.js" asp-append-version="true"></script>
}
