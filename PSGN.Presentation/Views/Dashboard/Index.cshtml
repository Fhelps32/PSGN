@model DashboardViewModel
@* Dashboard (DashboardController.Index): indicadores, gráfico de linha (alunos por mês) e de pizza (alunos por curso/módulo). Gráficos: dashboard.js *@
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Section"] = "Visão geral";
    ViewData["Subtitle"] = "Alunos e cursos sincronizados do Moodle";
}

<div class="page-header">
    <partial name="_PageHeader" />
</div>

@* ===== Indicadores (o card inteiro é um link) ===== *@
<div class="mb-6 grid gap-4 sm:grid-cols-2">
    <partial name="_Kpi" model='new IndicadorViewModel { Rotulo = "Total de alunos", Valor = Model.TotalAlunos, Icone = "bi-people", Controller = "Alunos" }' />
    <partial name="_Kpi" model='new IndicadorViewModel { Rotulo = "Total de cursos", Valor = Model.TotalCursos, Icone = "bi-book", Tom = "highlight", Controller = "Home" }' />
</div>

<div class="grid items-start gap-6 xl:grid-cols-[minmax(0,1fr)_minmax(0,24rem)]">

    @* ----- Gráfico em linha: alunos cadastrados por mês ----- *@
    <section class="card min-w-0" id="cardLinha" aria-labelledby="tituloLinha">
        <div class="card-header">
            <div>
                <h2 id="tituloLinha" class="card-title">Histórico de alunos</h2>
                <p class="card-desc">Alunos cadastrados no PSGN a cada mês</p>
            </div>
            <div class="flex w-full flex-wrap gap-2 sm:w-auto">
                @* Sem opção vazia: "tempo" é int no controller e value="" daria erro 400 *@
                <select id="selectTempoLinha" aria-label="Período do histórico" asp-items="Model.LineGraphSection.Tempo" class="input w-full sm:w-auto"></select>
                <select id="selectCursoLinha" aria-label="Curso do histórico" asp-items="Model.LineGraphSection.Cursos" class="input w-full sm:w-56">
                    <option value="">Todos os cursos</option>
                </select>
            </div>
        </div>
        <div class="card-body">
            <div class="relative h-72">
                @* role="img" + aria-label: texto alternativo, reescrito pelo dashboard.js com os valores *@
                <canvas id="lineGraphAlunos" role="img" aria-label="Gráfico de linha: alunos cadastrados por mês"></canvas>
            </div>
        </div>
    </section>

    @* ----- Gráfico de pizza: alunos por curso (ou por módulo) ----- *@
    <section class="card min-w-0" id="cardPizza" aria-labelledby="tituloPizza">
        <div class="card-header">
            <div class="w-full">
                <h2 id="tituloPizza" class="card-title">Alunos por curso</h2>
                <p class="card-desc">Escolha um curso para ver a divisão por módulo</p>
                <select id="selectCursoPizza" aria-label="Curso do gráfico de alunos por curso" asp-items="Model.SectorGraphSection.Cursos" class="input mt-3">
                    <option value="">Todos os cursos</option>
                </select>
            </div>
        </div>
        <div class="card-body flex flex-col gap-5 md:flex-row md:items-center xl:flex-col xl:items-stretch">
            <div class="relative mx-auto h-48 w-48 shrink-0 md:mx-0 xl:mx-auto">
                <canvas id="pieGraphCursos" role="img" aria-label="Gráfico de pizza: alunos por curso"></canvas>
            </div>
            @* Legenda em HTML (dashboard.js): cor, nome, quantidade e porcentagem *@
            <ul id="pieLegenda" class="min-w-0 flex-1 space-y-2.5 text-xs"></ul>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/lib/chart.js/dist/chart.umd.js" asp-append-version="true"></script>

    @* Dados do ViewModel e URLs dos endpoints para o dashboard.js (JSON não executável; Json.Serialize trata acentos e aspas) *@
    <script id="dashboard-data" type="application/json">
        @Json.Serialize(new
        {
            lineLabels = Model.LineGraphSection.ValueLineGraph.Select(p => p.Data.ToString("MM/yyyy")),
            lineData = Model.LineGraphSection.ValueLineGraph.Select(p => p.QuantidadeAlunos),
            pieLabels = Model.SectorGraphSection.ValueSectorGraph.Select(f => string.IsNullOrEmpty(f.Modulo) ? f.Curso : $"{f.Curso} - {f.Modulo}"),
            pieData = Model.SectorGraphSection.ValueSectorGraph.Select(f => f.QuantidadeAlunos),
            urlLinha = Url.Action("GetLineGraphData", "Dashboard"),
            urlPizza = Url.Action("GetPieGraphData", "Dashboard")
        })
    </script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
