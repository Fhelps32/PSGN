@model PSGN.Presentation.ViewModels.HomeViewModel
@* Tela de Cursos (HomeController.Index): botão de sincronização com Moodle e NSG e a lista de cursos, cada um abrindo seus módulos *@
@{
    ViewData["Title"] = "Cursos";
    ViewData["Section"] = "Acadêmico";
    ViewData["Subtitle"] = "Cursos e módulos sincronizados com o Moodle e o NSG";
}

<div class="page-header">
    <partial name="_PageHeader" />
    <div class="page-actions">
        @* data-loading: estado "Sincronizando…" do ui.js (bloqueia o segundo clique) *@
        <form asp-action="Sincronizar" method="post" data-loading>
            <button type="submit" class="btn btn-primary" data-loading-text="Sincronizando…">
                <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                <span data-loading-label>Sincronizar com Moodle e NSG</span>
            </button>
        </form>
    </div>
</div>

@* Sucesso vira toast (ui.js) *@
@if (Model.MensagemSincronizacao is not null)
{
    <template data-toast="success">@Model.MensagemSincronizacao</template>
}

@* Erro de conexão fica fixo, para o usuário ler o motivo *@
@if (Model.ErroSincronizacao is not null)
{
    <div class="mb-6"><partial name="_Alert" model='new AlertaViewModel { Tipo = "danger", Mensagem = Model.ErroSincronizacao }' /></div>
}

@if (Model.Cursos.Count == 0)
{
    <div class="card">
        <partial name="_EmptyState" model='new EstadoVazioViewModel { Icone = "bi-book", Titulo = "Nenhum curso sincronizado", Descricao = "Use Sincronizar com Moodle e NSG, no topo da página, para trazer os cursos e os módulos." }' />
    </div>
}
else
{
    <p class="mb-3 text-sm text-ink-soft"><span class="font-medium tabular-nums text-ink">@Model.Cursos.Count</span> @(Model.Cursos.Count == 1 ? "curso" : "cursos"). Abra um curso para ver os módulos.</p>

    @* <details>: abre e fecha sem JavaScript e funciona pelo teclado *@
    <div class="space-y-3">
        @foreach (var curso in Model.Cursos)
        {
            <details class="card group open:border-accent-icon">
                <summary class="flex cursor-pointer list-none items-center gap-3 rounded-card px-5 py-4 transition-colors hover:bg-surface-hover group-open:rounded-b-none group-open:bg-accent-soft [&::-webkit-details-marker]:hidden">
                    <i class="bi bi-chevron-right text-accent-icon transition-transform group-open:rotate-90" aria-hidden="true"></i>
                    <div class="min-w-0 flex-1">
                        <h2 class="break-words text-base font-semibold text-ink">@curso.Nome</h2>
                        <p class="mt-0.5 text-xs text-ink-soft"><i class="bi bi-person mr-1" aria-hidden="true"></i>@curso.Coordenador</p>
                    </div>
                    <span class="badge shrink-0 tabular-nums">@curso.Modulos.Count @(curso.Modulos.Count == 1 ? "módulo" : "módulos")</span>
                </summary>

                <ul class="divide-y divide-line border-t border-line">
                    @foreach (var modulo in curso.Modulos)
                    {
                        <li class="flex items-center justify-between gap-3 px-5 py-2.5 text-sm">
                            <span class="min-w-0 break-words text-ink">@modulo.Nome</span>
                            <span class="shrink-0 text-xs tabular-nums text-ink-muted" title="Identificador do módulo no Moodle">Moodle #@modulo.IdMoodle</span>
                        </li>
                    }
                </ul>
            </details>
        }
    </div>
}
