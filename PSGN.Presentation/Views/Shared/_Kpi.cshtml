@model IndicadorViewModel
@* Indicador do Dashboard: rótulo, número e ícone; o card inteiro é o link. Model.Tom escolhe a cor do tile (accent = sky, highlight = coral) *@
<a asp-controller="@Model.Controller" asp-action="@Model.Action" class="kpi group">
    <div>
        <p class="kpi-label">@Model.Rotulo</p>
        <p class="kpi-value">@Model.Valor</p>
    </div>
    <span class="kpi-icon kpi-icon-@Model.Tom" aria-hidden="true"><i class="bi @Model.Icone"></i></span>
</a>
