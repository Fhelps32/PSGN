@model IndicadorViewModel
@* REVISÃO: partial nova. Indicador (KPI): rótulo, número grande e ícone discreto. O card inteiro é o link, então não precisa de botões "Ver…" repetindo a sidebar *@
<a asp-controller="@Model.Controller" asp-action="@Model.Action" class="kpi group">
    <div>
        <p class="kpi-label">@Model.Rotulo</p> @* o que está sendo contado *@
        <p class="kpi-value">@Model.Valor</p> @* o número *@
    </div>
    <span class="kpi-icon" aria-hidden="true"><i class="bi @Model.Icone"></i></span> @* ícone decorativo *@
</a>
