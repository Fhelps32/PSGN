@model AlertaViewModel
@* Aviso fixo com ícone, texto e botão de fechar (ui.js). Modelo: AlertaViewModel. Usado nas telas de Cursos e Alunos *@
@{
    var icone = Model.Tipo switch // ícone de cada tipo
    {
        "danger" => "bi-exclamation-octagon",
        "warning" => "bi-exclamation-triangle",
        "info" => "bi-info-circle",
        _ => "bi-check-circle" // sucesso
    };
}
<div role="@(Model.Tipo == "danger" ? "alert" : "status")" class="alert alert-@Model.Tipo">
    <i class="bi @icone mt-0.5 shrink-0" aria-hidden="true"></i>
    <p class="min-w-0 break-words">@Model.Mensagem</p>
    @if (Model.Fechavel)
    {
        <button type="button" class="alert-close" data-dismiss="alert" aria-label="Fechar aviso"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
    }
</div>
