@* Barra superior abaixo de 1024px: botão que abre a sidebar e o título da página *@
<header id="topbar" class="topbar">
    <button id="openSidebar" type="button" class="btn btn-ghost btn-icon -ml-2" aria-controls="sidebar" aria-expanded="false" aria-label="Abrir menu">
        <i class="bi bi-list text-xl" aria-hidden="true"></i>
    </button>
    <span class="sidebar-logo" aria-hidden="true"><i class="bi bi-mortarboard-fill"></i></span>
    <span class="topbar-title">@ViewData["Title"]</span>
</header>
