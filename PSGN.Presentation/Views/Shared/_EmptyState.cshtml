@model EstadoVazioViewModel
@* Estado vazio: ícone, título e descrição. Modelo: EstadoVazioViewModel. Usado nas telas de Cursos e Alunos *@
<div class="empty">
    <span class="empty-icon" aria-hidden="true"><i class="bi @Model.Icone"></i></span>
    <p class="empty-title">@Model.Titulo</p>
    @if (!string.IsNullOrEmpty(Model.Descricao))
    {
        <p class="empty-desc">@Model.Descricao</p>
    }
</div>
