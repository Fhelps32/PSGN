@* Menu lateral: fixo e recolhível a partir de 1024px, painel sobreposto abaixo disso. Visual: layout.css; comportamento: sidebar.js *@
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();

    var grupos = new[] // grupos de navegação; cada grupo tem um título e seus itens (só as telas que existem hoje)
    {
        new { Titulo = "Visão geral", Itens = new[] { new { Ctrl = "Dashboard", Icone = "bi-grid-1x2", Rotulo = "Dashboard" } } },
        new { Titulo = "Acadêmico", Itens = new[] { new { Ctrl = "Home", Icone = "bi-book", Rotulo = "Cursos" }, new { Ctrl = "Alunos", Icone = "bi-people", Rotulo = "Alunos" } } }
    };
}

<aside id="sidebar" aria-label="Menu lateral" data-open="false">

    <div class="sidebar-header">
        <div class="sidebar-brand">
            <span class="sidebar-logo" aria-hidden="true"><i class="bi bi-mortarboard-fill"></i></span>
            <span class="sidebar-name sidebar-label">PSGN</span>
        </div>

        @* Recolher/expandir (desktop). O sidebar.js mantém aria-expanded, aria-label e o tooltip *@
        <button id="toggleSidebar" type="button" class="btn btn-ghost btn-icon hidden lg:inline-flex" aria-controls="sidebar" aria-expanded="true" aria-label="Recolher menu"
                data-tooltip="Recolher menu" data-tooltip-placement="right">
            <i class="bi bi-list text-xl" aria-hidden="true"></i>
        </button>

        <button id="closeSidebar" type="button" class="btn btn-ghost btn-icon lg:hidden" aria-controls="sidebar" aria-label="Fechar menu">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
    </div>

    <nav class="sidebar-nav" aria-label="Navegação principal">
        @foreach (var grupo in grupos)
        {
            <div class="nav-group">
                <p class="nav-group-label">@grupo.Titulo</p>
                <ul class="space-y-0.5">
                    @foreach (var item in grupo.Itens)
                    {
                        var ativo = controller == item.Ctrl;
                        <li>
                            @* aria-label para a sidebar recolhida (só ícone); data-tooltip só aparece recolhida (ui.js) *@
                            <a asp-controller="@item.Ctrl" asp-action="Index" class="nav-link"
                               aria-label="@item.Rotulo" aria-current="@(ativo ? "page" : null)"
                               data-tooltip="@item.Rotulo" data-tooltip-placement="right" data-tooltip-if="sidebar-collapsed">
                                <i class="bi @item.Icone" aria-hidden="true"></i>
                                <span class="sidebar-label">@item.Rotulo</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }
    </nav>

</aside>

@* Fundo atrás do painel aberto no celular; clicar fecha (sidebar.js) *@
<div id="sidebarOverlay" hidden class="fixed inset-0 z-30 lg:hidden"></div>
