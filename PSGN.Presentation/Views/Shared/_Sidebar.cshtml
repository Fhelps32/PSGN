@* REVISÃO: sidebar do redesign. Itens agrupados por tema, item ativo com barra de acento, tooltip nos ícones quando recolhida e botão de recolher no cabeçalho.
   Abaixo de 1024px vira painel sobreposto (aberto pelo botão da _Topbar); a partir de 1024px fica fixa. Largura e deslocamento: Styles/layout.css; comportamento: wwwroot/js/sidebar.js *@
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString(); // controller da página atual, para destacar o item ativo

    var grupos = new[] // grupos de navegação; cada grupo tem um título e seus itens (só as telas que existem hoje)
    {
        new { Titulo = "Visão geral", Itens = new[] { new { Ctrl = "Dashboard", Icone = "bi-grid-1x2", Rotulo = "Dashboard" } } }, // grupo de resumo
        new { Titulo = "Acadêmico", Itens = new[] { new { Ctrl = "Home", Icone = "bi-book", Rotulo = "Cursos" }, new { Ctrl = "Alunos", Icone = "bi-people", Rotulo = "Alunos" } } } // grupo dos cadastros: Cursos (controller Home) e Alunos
    }; // fim dos grupos
}

@* aside: no celular é um painel fora da tela (data-open="true" o traz para dentro); no desktop é fixo. Visual no layout.css *@
<aside id="sidebar" aria-label="Menu lateral" data-open="false">

    @* Cabeçalho: logo + botão de fechar (só no celular) *@
    <div class="sidebar-header">
        <div class="sidebar-brand"> @* logo: quadrado azul com o ícone + nome; recolhida, só o quadrado *@
            <span class="sidebar-logo" aria-hidden="true"><i class="bi bi-mortarboard-fill"></i></span> @* ícone de capelo (decorativo) *@
            <span class="sidebar-name sidebar-label">PSGN</span> @* nome do sistema *@
        </div>

        @* REVISÃO: desktop: recolhe/expande. Voltou para o cabeçalho, à direita do logo (estava no rodapé). Recolhida, o cabeçalho mostra só este botão (layout.css).
           O sidebar.js mantém aria-expanded, aria-label e o tooltip com a ação atual ("Recolher menu"/"Expandir menu"); o tooltip aparece sempre, porque o botão só tem ícone *@
        <button id="toggleSidebar" type="button" class="btn btn-ghost btn-icon hidden lg:inline-flex" aria-controls="sidebar" aria-expanded="true" aria-label="Recolher menu"
                data-tooltip="Recolher menu" data-tooltip-placement="right">
            <i class="bi bi-list text-xl" aria-hidden="true"></i> @* ícone de "hambúrguer", o mesmo do PSG *@
        </button>

        @* Celular/tablet: fecha o painel *@
        <button id="closeSidebar" type="button" class="btn btn-ghost btn-icon lg:hidden" aria-controls="sidebar" aria-label="Fechar menu">
            <i class="bi bi-x-lg" aria-hidden="true"></i> @* ícone de X *@
        </button>
    </div>

    @* Navegação: um bloco por grupo *@
    <nav class="sidebar-nav" aria-label="Navegação principal">
        @foreach (var grupo in grupos) // um bloco por grupo
        {
            <div class="nav-group">
                <p class="nav-group-label">@grupo.Titulo</p> @* título do grupo; recolhida, vira uma linha divisória (layout.css) *@
                <ul class="space-y-0.5"> @* lista de itens do grupo *@
                    @foreach (var item in grupo.Itens) // um link por item
                    {
                        var ativo = controller == item.Ctrl; // é a página atual?
                        <li>
                            @* aria-label: com a sidebar recolhida o texto some, então o nome do link precisa estar no atributo; aria-current avisa o leitor de tela qual é a página atual;
                               data-tooltip: o ui.js mostra o nome ao lado do ícone, mas só com a sidebar recolhida *@
                            <a asp-controller="@item.Ctrl" asp-action="Index" class="nav-link"
                               aria-label="@item.Rotulo" aria-current="@(ativo ? "page" : null)"
                               data-tooltip="@item.Rotulo" data-tooltip-placement="right" data-tooltip-if="sidebar-collapsed">
                                <i class="bi @item.Icone" aria-hidden="true"></i> @* ícone do item (decorativo) *@
                                <span class="sidebar-label">@item.Rotulo</span> @* texto; some quando a sidebar recolhe *@
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }
    </nav>

    @* REVISÃO: o rodapé com o botão de recolher foi removido; o botão agora fica no cabeçalho *@
</aside>

@* Overlay: fundo escuro atrás do painel aberto; clicar nele fecha. Só existe abaixo de 1024px (lg:hidden) e começa escondido (atributo hidden) *@
<div id="sidebarOverlay" hidden class="fixed inset-0 z-30 lg:hidden"></div>
