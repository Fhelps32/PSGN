@* Título da página: grupo (ViewData["Section"]), título (ViewData["Title"]) e subtítulo opcional. Usado no topo de todas as páginas *@
<div class="min-w-0">
    @if (ViewData["Section"] is string secao)
    {
        <p class="page-eyebrow">@secao</p>
    }
    <h1 class="page-title">@ViewData["Title"]</h1>
    @if (ViewData["Subtitle"] is string subtitulo)
    {
        <p class="page-subtitle">@subtitulo</p>
    }
</div>
